# Copy to .env and fill in your own values. Never commit the filled file.

# Azure Document Intelligence (OCR)
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=
AZURE_ENDPOINT=
AZURE_KEY=

# Groq (LLM address parsing)
GROQ_API_KEY=

# Firebase Admin service account, path to the JSON file on disk.
# Keep the file outside the repo, or in a gitignored directory.
FIREBASE_CREDENTIALS=

# Twilio (delivery notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps Platform (geocoding, places, directions)
GOOGLE_API_KEY=
